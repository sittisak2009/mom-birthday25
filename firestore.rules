rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ข้อความ วันเกิด และรายการคำอวยพร
    match /site/content {
      allow read: if true;
      allow create, update: if request.resource.data.editKey == '25'
        && request.resource.data.keys().hasOnly(['texts','wishes','captions','date','photosSet','editKey','updatedAt'])
        && request.resource.data.wishes.size() <= 30
        && request.resource.data.captions.size() <= 30
        && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.photosSet is bool;
      allow delete: if resource.data.editKey == '25';
    }

    // รูปภาพ (เก็บรูปละหนึ่งเอกสาร)
    match /photos/{id} {
      allow read: if true;
      allow create, update: if request.resource.data.editKey == '25'
        && request.resource.data.keys().hasOnly(['img','caption','order','editKey'])
        && request.resource.data.img is string
        && request.resource.data.img.size() < 900000
        && request.resource.data.caption.size() <= 200
        && request.resource.data.order is number;
      allow delete: if resource.data.editKey == '25';
    }
  }
}
