rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /site/content {
      allow read: if true;
      allow create, update: if request.resource.data.editKey == '25'
        && request.resource.data.keys().hasOnly(['texts', 'wishes', 'captions', 'editKey', 'updatedAt'])
        && request.resource.data.wishes.size() <= 30
        && request.resource.data.captions.size() <= 30;
      allow delete: if resource.data.editKey == '25';
    }
  }
}
